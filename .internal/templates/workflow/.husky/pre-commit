#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

echo "=== Pre-commit checks ==="

# 1. Type check
echo "Running type check..."
{{TYPECHECK_CMD}}
if [ $? -ne 0 ]; then
  echo "ABORT: Type errors found. Fix them before committing."
  exit 1
fi

# 2. Lint
echo "Running lint..."
{{LINT_CMD}}
if [ $? -ne 0 ]; then
  echo "ABORT: Lint errors found. Fix them before committing."
  exit 1
fi

echo "=== All pre-commit checks passed ==="
