# ─── Client-side env vars (bundled by Expo) ────
# All vars must be prefixed EXPO_PUBLIC_ to be accessible in the app bundle.

# Firebase — Web app config (Firebase Console > Project Settings > Your apps)
# See FIREBASE_SETUP.md for step-by-step setup instructions.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Stripe — Publishable key (safe for client-side)
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
